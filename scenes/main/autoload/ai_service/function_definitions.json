  {
    "name": "activate_focus_mode",
    "description": "一键开启专注模式（联动番茄钟、音乐与环境）。当用户表达“进入专注模式/开始专注/深度学习模式/我要专心”时优先调用此函数。",
    "parameters": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["deep", "calm", "light"],
          "description": "专注预设：deep=深度专注（夜间+雨声），calm=平静专注（柔和环境），light=轻量专注（白天轻背景）",
          "default": "deep"
        },
        "work_minutes": { "type": "integer", "description": "番茄钟工作时长（分钟）", "default": 25 },
        "rest_minutes": { "type": "integer", "description": "番茄钟休息时长（分钟）", "default": 5 },
        "loop_times": { "type": "integer", "description": "番茄钟循环次数", "default": 1 },
        "playlist_name": { "type": "string", "description": "目标播放列表（可选）" },
        "track_name": { "type": "string", "description": "目标曲目名称（可选）" },
        "play_mode": {
          "type": "integer",
          "enum": [0, 1, 2],
          "description": "播放模式：0=顺序播放, 1=随机播放, 2=单曲循环（不传使用预设）"
        },
        "bgm_volume": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "背景音乐音量（0.0-1.0）" },
        "time_mode": { "type": "integer", "enum": [0, 1, 2, 3], "description": "环境时间模式（可选覆盖预设）" },
        "weather_mode": { "type": "integer", "enum": [0, 1, 2, 3], "description": "环境天气模式（可选覆盖预设）" },
        "rain_amount": { "type": "integer", "description": "雨量强度（可选覆盖预设）" },
        "snow_amount": { "type": "integer", "description": "雪量强度（可选覆盖预设）" },
        "fog_state": { "type": "integer", "enum": [0, 1], "description": "雾效状态（可选覆盖预设）" },
        "render_scale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.0,
          "description": "3D 渲染缩放（可选覆盖预设）"
        },
        "ai_response_glow": { "type": "boolean", "description": "AI 回复流光开关（可选，默认关闭）" },
        "rain_sound_volume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "雨声音量（可选覆盖预设）"
        },
        "wind_sound_volume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "风声音量（可选覆盖预设）"
        },
        "car_sound_volume": {
          "type": "integer",
